@page "{id:int}"
@model TravelRequestWF.Web.Pages.Employee.DetailModel
@{
    ViewData["Title"] = "Request Detail";
}

<h2>Request Detail</h2>
<a asp-page="/Employee/Index" class="btn btn-secondary mb-3">← Back to My Requests</a>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Request == null)
{
    <div class="alert alert-warning" role="alert">Request not found.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@Model.Request.Destination</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9">@Model.Request.StartDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">End Date</dt>
                <dd class="col-sm-9">@Model.Request.EndDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Purpose</dt>
                <dd class="col-sm-9">@Model.Request.Purpose</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @switch (Model.Request.Status)
                    {
                        case TravelRequestStatus.Pending:
                            <span class="badge bg-warning text-dark">Pending</span>
                            break;
                        case TravelRequestStatus.Approved:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case TravelRequestStatus.Rejected:
                            <span class="badge bg-danger">Rejected</span>
                            break;
                        case TravelRequestStatus.Returned:
                            <span class="badge bg-secondary">Returned</span>
                            break;
                    }
                </dd>

                <dt class="col-sm-3">Submitted</dt>
                <dd class="col-sm-9">@Model.Request.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Approver</dt>
                <dd class="col-sm-9">@(Model.Request.Approver?.Name ?? "—")</dd>
            </dl>
        </div>
    </div>

    <h4>Documents</h4>
    @if (!Model.Request.Documents.Any())
    {
        <p class="text-muted">No documents attached.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Download</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model.Request.Documents)
                {
                    <tr>
                        <td>@doc.FileName</td>
                        <td><a href="@doc.BlobUrl" target="_blank" class="btn btn-sm btn-outline-secondary">Download</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 class="mt-4">Audit Trail</h4>
    @if (!Model.Request.AuditLog.Where(e => e.TravelRequestId.HasValue).Any())
    {
        <p class="text-muted">No audit entries yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Actor</th>
                    <th>Timestamp</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Request.AuditLog.Where(e => e.TravelRequestId.HasValue).OrderBy(e => e.Timestamp))
                {
                    <tr>
                        <td>@entry.Action</td>
                        <td>@entry.ActorId</td>
                        <td>@entry.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(entry.Details ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.CanResubmit)
    {
        <div class="card border-warning mt-4">
            <div class="card-body">
                <p class="text-muted">This request was returned for more information. Review the audit trail and resubmit when ready.</p>
                <form method="post" asp-page-handler="Resubmit" asp-route-id="@Model.Request.Id">
                    <button type="submit" class="btn btn-warning">Resubmit Request</button>
                </form>
            </div>
        </div>
    }
}
